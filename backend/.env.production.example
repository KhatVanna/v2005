APP_NAME=V2005
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Neon PostgreSQL (production)
# Prefer DB_URL — includes SSL required by Neon.
DB_CONNECTION=pgsql
DB_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-divine-hill-b3dw3jxr.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DB_HOST=ep-divine-hill-b3dw3jxr.c-4.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_NEON_PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Same Cloudinary cloud for local + production
CLOUDINARY_CLOUD_NAME=v2005
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=v2005/products
CLOUDINARY_URL=

SANCTUM_STATEFUL_DOMAINS=your-store.domain.com,your-admin.domain.com
FRONTEND_USER_URL=https://your-store.domain.com
FRONTEND_ADMIN_URL=https://your-admin.domain.com

VITE_APP_NAME="${APP_NAME}"
